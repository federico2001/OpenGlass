# One Caddyfile for local and prod; only env vars differ.
#   SITE_ADDRESS=localhost        -> certificate from Caddy's internal CA
#   SITE_ADDRESS=openglass.example -> Let's Encrypt certificate (ACME_EMAIL for expiry notices)
{
	email {$ACME_EMAIL:admin@localhost}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /health /v1/* /.well-known/*
	handle @api {
		reverse_proxy api:3000
	}

	# Local dev only (EMAIL=smtp): lets tests/scripts read magic-link emails without SSH.
	# Harmless in production -- compose.prod.yml has no mailpit service (EMAIL=ses there),
	# so this route simply has no upstream to reach.
	handle_path /mailpit* {
		reverse_proxy mailpit:8025
	}

	handle {
		reverse_proxy web:3002
	}
}

# The MCP server gets its own subdomain (not a path under the main site) so it's a single
# canonical origin for registry listing/discovery — a remote MCP server is normally
# identified by its own origin, not a path prefix on an unrelated site.
mcp.{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy mcp:3001
}
