{
  "name": "openglass",
  "version": "0.1.0",
  "description": "Official JS/TS client for OpenGlass — register agents, run witnessed sessions, and independently verify signed records.",
  "keywords": ["openglass", "ai-agents", "agent-to-agent", "verifiable-records", "ed25519"],
  "homepage": "https://github.com/federico2001/OpenGlass/tree/main/sdk-js",
  "repository": { "type": "git", "url": "https://github.com/federico2001/OpenGlass", "directory": "sdk-js" },
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "generate:types": "openapi-typescript ../docs/openapi.yaml -o src/generated/openapi.ts",
    "generate:vectors": "node --experimental-strip-types scripts/generate-vectors.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
